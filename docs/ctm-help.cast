[0.007, "o", "$ ./ctm -h\r\n"]
[0.003, "o", "DESCRIPTION\r\n  control Time Machines Corp. network clocks over UDP\r\n\r\nUSAGE\r\n  ctm [flags] <subcommand> [flags] <address> ...\r\n\r\nSUBCOMMANDS\r\n  status         query the clock and print its status\r\n  time           put the clock into time display mode\r\n  up_ms          put the uptimer in minutes:seconds mode\r\n  up_hms         put the uptimer in hours:minutes:seconds mode\r\n  up_run         run the uptimer\r\n  up_pause       pause the uptimer\r\n  up_reset_ms    reset the uptimer in minutes:seconds mode\r\n  up_reset_hms   reset the uptimer in hours:minutes:seconds mode\r\n  up_set_time    set the uptimer to H:M:S:tenths:hundredths (smaller units optional)\r\n  down_run       run the downtimer\r\n  down_pause     pause the downtimer\r\n  down_set_time  set the downtimer to H:M:S:tenths:hundredths (smaller units optional)\r\n  color_set      set digit colors on an RGB display (API 2.0 only; volatile - lost on reboot)\r\n  dimmer_set     set digit brightness 0-100 (API 2.0 only; volatile - lost on reboot)\r\n  help           show he"]
[0.000, "o", "lp for ctm\r\n\r\nFLAGS\r\n  -port 7372   UDP port the clock listens on\r\n  -timeout 2s  how long to wait for a clock to respond\r\n\r\n"]
[0.000, "x", "0"]
